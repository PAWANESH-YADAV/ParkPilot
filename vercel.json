{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rootDirectory": "frontend",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && next build",
  "outputDirectory": ".next",
  "devCommand": "cd frontend && next dev",
  "functions": {
    "frontend/.next/server/**/*.js": {
      "includeFiles": "frontend/node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://parkpilot-backend-production.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://parkpilot-backend-production.up.railway.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
