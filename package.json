{
  "name": "parkpilot",
  "version": "1.0.0",
  "private": true,
  "description": "ParkPilot - Smart Parking Management System (Next.js + FastAPI Monorepo)",
  "scripts": {
    "vercel-build": "cd frontend && npm install && next build",
    "vercel-dev": "cd frontend && next dev",
    "vercel-start": "cd frontend && next start",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "dev:frontend": "cd frontend && next dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "start:frontend": "cd frontend && next start",
    "start:backend": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "workspaces": [
    "frontend"
  ]
}
